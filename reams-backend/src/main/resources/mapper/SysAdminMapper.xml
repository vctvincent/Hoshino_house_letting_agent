<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reams.mapper.SysAdminMapper">

    <resultMap id="BaseResultMap" type="com.reams.entity.SysAdmin">
        <id column="admin_id" property="id"/>
        <result column="admin_name" property="name"/>
        <result column="admin_password" property="password"/>
        <result column="admin_email" property="email"/>
        <result column="admin_phone" property="phone"/>
        <result column="admin_avatar" property="avatar"/>
        <result column="admin_create_time" property="createTime"/>
        <result column="admin_update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByName" resultMap="BaseResultMap">
        SELECT * FROM sys_admin WHERE admin_name = #{name}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM sys_admin ORDER BY admin_create_time DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_admin WHERE admin_id = #{id}
    </select>

    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT * FROM sys_admin WHERE admin_phone = #{phone}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_admin (
            admin_name, admin_password, admin_email, admin_phone, admin_avatar
        ) VALUES (
            #{name}, #{password}, #{email}, #{phone}, #{avatar}
        )
    </insert>

    <update id="update">
        UPDATE sys_admin
        <set>
            <if test="name != null and name != ''">admin_name = #{name},</if>
            <if test="password != null and password != ''">admin_password = #{password},</if>
            <if test="email != null">admin_email = #{email},</if>
            <if test="phone != null">admin_phone = #{phone},</if>
            <if test="avatar != null">admin_avatar = #{avatar},</if>
        </set>
        WHERE admin_id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_admin WHERE admin_id = #{id}
    </delete>

</mapper>
