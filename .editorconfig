root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.java]
indent_size = 4

[*.sql]
indent_size = 4

[*.{yml,yaml,xml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4
